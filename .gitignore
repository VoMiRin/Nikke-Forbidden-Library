# GraphRAG regenerable build outputs (5-1)
data/graph/manifest.json
data/graph/pass1/batches/
data/graph/pass1/waves/
data/graph/pass1/part_inputs/

# GraphRAG: keep current shards, progress, registry, indexes and tools.
# Merged shards contain the part outputs; old versions and review runs stay local.
/data/graph/pass1/parts/
/data/graph/pass1/repairs/
/data/graph/pass1/shards_*/
/data/graph/pilot/
/data/graph/reports/
/data/graph/gate/runs/
/data/graph/pass1_density_report.json
# Pass 2: bundles are regenerable (pass2-b.mjs build); pilot runs stay local like Pass 1 pilots
/data/graph/pass2/bundles/
/data/graph/pass2/pilot/

# Keep the README and the two GraphRAG documents required by its tooling.
# Work reports and one-off instructions stay on this computer.
/*.md
!/README.md
!/GRAPH_RAG_SPEC.md
!/GRAPH_RAG_PASS1_RULES.md
!/GRAPH_RAG_PASS2_B_RULES.md

