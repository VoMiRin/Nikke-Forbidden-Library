  "story": [
    {
      "scene_id": "maiden_00",
      "chronology_type": "present",
      "summary": "골목길에서 피 묻은 양산형 니케에게 습격당할 뻔한 지휘관을 메이든이 능력으로 구해 준다. 지휘관이 겁먹지 않고 진심으로 고마워하며 눈물을 닦아 주자 메이든은 반해 버리고, 전초기지로 돌아와 샤워를 마친 지휘관에게 '블랙로즈'로부터 샤워가 즐거웠냐는 문자가 온다.",
      "speakers": [
        {
          "label": "양산형 니케",
          "entity_id": null
        },
        {
          "label": "메이든",
          "entity_id": "char_메이든"
        },
        {
          "label": "지휘관",
          "entity_id": "char_지휘관"
        },
        {
          "label": "아나운서",
          "entity_id": null
