          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_killthelord_001__eac_002",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "로산나",
          "summary": "지휘관이 단체방이냐고 묻자, 로산나가 맞다며 이제 손을 잡기로 했으니 정보를 공유할 방도 있어야 한다고 답한다.",
          "line_start": 15,
          "line_end": 26,
          "claim_line": 22,
          "quote": "단체방이네? 맞아 우리 이제 손잡기로 했잖아? 그럼 정보를 공유할 방도 있어야지",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_killthelord_001__eac_003",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "D",
          "summary": "D가 공유할 내용이 있다면 이 방에 공유하겠다고 동의한다.",
          "line_start": 27,
          "line_end": 35,
          "claim_line": null,
          "quote": "좋아 공유할 내용이 있다면 여기 공유하도록 하지",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_killthelord_001__eac_004",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "로산나",
          "summary": "로산나가 자신과 도끼녀(D)의 조합이 정말 신선하다고 평한다.",
          "line_start": 36,
          "line_end": 47,
          "claim_line": 40,
          "quote": "그나저나 조합이 정말 신선하네 나랑 도끼녀의 조합이라니",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_killthelord_001__eac_005",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "로산나",
          "summary": "D가 어디가 신선하냐고 묻자, 로산나가 서로 보통은 마주칠 일이 없고 이번에 제대로 얼굴을 본 것도 처음이라 신선하다고 답한다.",
          "line_start": 48,
          "line_end": 62,
          "claim_line": 58,
          "quote": "어디가 신선하지? 너나 나나 보통은 마주칠 일이 없잖아 서로 이번에 제대로 얼굴을 본 것도 처음이고 그런 의미에서 신선하다는 거지",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_killthelord_001__eac_006",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "로산나",
          "summary": "로산나가 D가 워낙 변장을 잘한다는 소문이 있어서 D의 얼굴이 진짜인지 가짜인지도 모르겠다고 말한다.",
          "line_start": 63,
          "line_end": 74,
          "claim_line": 70,
          "quote": "그러고 보니 도끼녀 얼굴은 진짜인지 가짜인지도 모르겠네 워낙 변장을 잘한다는 소문이 있어서 ^^",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_killthelord_001__eac_007",
