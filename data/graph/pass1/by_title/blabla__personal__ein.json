        {
          "item_id": "blabla_ein_001__eac_006",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "아인",
          "summary": "지휘관이 그러냐고 되묻자 아인이 자신은 신선하게 느낀다고 답한다.",
          "line_start": 43,
          "line_end": 46,
          "claim_line": 45,
          "quote": "그런가?\n네 ㅋㅋ 전 그래요",
