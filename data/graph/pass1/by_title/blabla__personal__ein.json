        },
        {
          "item_id": "blabla_ein_001__eac_007",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "아인",
          "summary": "아인이 지휘관과 문자를 하는 것이 어색하지만 하다 보면 점점 익숙해질 것이라고 말한다.",
          "line_start": 50,
          "line_end": 58,
          "claim_line": 54,
          "quote": "쌤이랑 문자라니\nㅈㄴ 어색해요\n하다 보면 점점 익숙해지겠죠",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_ein_001__eac_008",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "아인",
          "summary": "아인이 지휘관에게 학교에 언제 또 오는지 묻는다.",
          "line_start": 59,
          "line_end": 64,
          "claim_line": null,
          "quote": "그나저나 쌤\n학교에는 언제 또 와요?",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_ein_001__eac_009",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 아인에게 학교에 언제 오는지는 왜 묻는지 되묻는다.",
          "line_start": 65,
          "line_end": 67,
          "claim_line": null,
          "quote": "글쎄? 그건 왜?",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_ein_001__eac_010",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "아인",
          "summary": "아인이 지휘관과 놀고 싶어서 학교에 언제 오는지 물었다고 답한다.",
          "line_start": 68,
          "line_end": 73,
          "claim_line": 72,
          "quote": "왜긴요\n쌤이랑 놀고 싶어서 그러죠",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_ein_001__eac_011",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "아인",
          "summary": "지휘관이 자신과 놀고 싶다는 것이냐고 되묻자, 아인이 지휘관과 노는 것이 무척 재미있다고 답한다.",
          "line_start": 74,
          "line_end": 82,
          "claim_line": 81,
          "quote": "나랑?\nㅇㅇ 그쵸\n쌤이랑 노는 게 개꿀잼이거든요",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_ein_001__eac_012",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "아인",
          "summary": "아인이 다른 선배들이나 마르차나까지도 직접 말은 안 해도 지휘관이 오는 날을 기다리는 것이 눈에 훤히 보인다며, 다른 사람들도 지휘관과 노는 것이 재미있는 모양이라고 말한다.",
          "line_start": 83,
          "line_end": 100,
          "claim_line": 93,
          "quote": "그리고 직접 말은 안 해도\n다른 선배들이나\n심지어 마르차나 쌤까지도\n쌤이 오는 날을 기다리는 게\n눈에 훤히 다 보여요 ㅋㅋㅋ\n다른 사람들도 쌤이랑 노는 게 재밌나 봐요",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_ein_001__eac_013",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "아인",
          "summary": "아인이 지휘관에게 오늘 학교 끝나면 완전히 한가하다며 오늘 학교에 오면 안 되느냐고 요청한다.",
          "line_start": 101,
          "line_end": 112,
          "claim_line": null,
          "quote": "그니까 쌤\n언제 올 건지 딱 정해줘요\n오늘은 안 돼요?\n저 오늘 학교 끝나면 완전 한가한데",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_ein_001__eac_014",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "아인",
          "summary": "지휘관이 오늘을 말하는 것이냐고 묻자 아인이 오늘 와 달라고 거듭 맞장구친다.",
          "line_start": 113,
          "line_end": 118,
          "claim_line": null,
          "quote": "오늘?\n네ㄴ네넨네ㅔ 오늘오느ㄹㅇㅗ늘",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_ein_001__eac_015",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 아인이 하교할 때쯤이면 학교에 가도 괜찮을 것 같다고 답한다.",
          "line_start": 119,
          "line_end": 121,
          "claim_line": 120,
          "quote": "아인이 하교할 때쯤이면 괜찮을 것 같아",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_ein_001__eac_016",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "아인",
          "summary": "아인이 기뻐하며 오늘 오는 것으로 약속했다고 못 박고, 지휘관을 기다리겠다며 선배들에게 자랑하겠다고 말한다.",
          "line_start": 122,
          "line_end": 133,
          "claim_line": null,
          "quote": "아싸ㅏㅏㅏ!! 그럼 오늘 오는 거죠?\n약속했어요!\n그럼 기다릴게요 쌤!\n오예ㅔㅔㅔ!! 선배들한테 자랑해야지",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        }
