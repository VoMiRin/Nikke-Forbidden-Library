        },
        {
          "item_id": "blabla_prika_001__eac_003",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "프리카",
          "summary": "프리카가 자신의 개인 연락처라 실수로 다른 사람에게 연락이 가면 여러모로 귀찮아진다며 안도한다.",
          "line_start": 12,
          "line_end": 23,
          "claim_line": 16,
          "quote": "아 다행이다 이거 내 개인 연락처라서 실수로 다른 사람에게 연락가거나 하면 여러모로 귀찮아지거든",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_004",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 연예인은 어딘가에 연락하는 것도 힘들겠다고 말한다.",
          "line_start": 24,
          "line_end": 26,
          "claim_line": 25,
          "quote": "연예인은 어디 연락하는 것도 힘들겠네",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_005",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "프리카",
          "summary": "프리카가 자신의 행동 하나하나가 기사가 되는 세상이라 평소에는 메시지도 잘 하지 않는 편이라고 말한다.",
          "line_start": 27,
          "line_end": 35,
          "claim_line": 31,
          "quote": "그렇지 내 행동 하나하나가 기사가 되는 세상이니까 그래서 메시지도 평소에는 잘 안 하는 편이야",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_006",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 프리카에게 평소 메시지를 잘 하지 않으면 심심하겠다고 말한다.",
          "line_start": 36,
          "line_end": 38,
          "claim_line": 37,
          "quote": "심심하겠다",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_007",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "프리카",
          "summary": "프리카가 스케줄 중에는 휴대폰을 못 보고 그 외 시간에는 작업이나 연습을 해서 애초에 휴대폰을 잘 쓰지 않는 편이라 심심하지는 않다고 답한다.",
          "line_start": 39,
          "line_end": 50,
          "claim_line": 43,
          "quote": "그렇지는 않아 스케줄 할 때는 어차피 휴대폰 못 보고 그 외의 시간에는 작업하거나 연습하거나 하니까 애초에 폰을 잘 안쓰는 편이라고 해야하나",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_008",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 프리카에게 자신에게는 무슨 일로 연락했는지 묻는다.",
          "line_start": 51,
          "line_end": 56,
          "claim_line": null,
          "quote": "그렇구나 그럼 나한테는 무슨 일로 연락한 거야?",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_009",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "프리카",
          "summary": "프리카가 생각이 막히거나 답답할 때 지휘관과 이야기를 하면 풀리는 기분이 든다며 앞으로 종종 연락해도 될지 묻는다.",
          "line_start": 57,
          "line_end": 80,
          "claim_line": 73,
          "quote": "뮤즈한테는 앞으로 종종 연락할 일이 있을 것 같아서 염치없기는 하지만 생각이 막히거나, 답답하거나 그럴 때 뮤즈와 얘기를 좀 하고 나면 탁 풀리는 기분이 들거든 그래서 혹시 뮤즈만 괜찮다면 이렇게 종종 연락해도 될까?",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_010",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 그런 이유라면 언제든 연락해도 환영이라고 수락한다.",
          "line_start": 81,
          "line_end": 83,
          "claim_line": null,
          "quote": "그런 이유라면 언제든 환영이야",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_011",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "프리카",
          "summary": "프리카가 고마워하며 지금도 연습실에서 춤 연습을 하다가 특정 부분이 잘 안 돼서 쉬고 있었다고 말한다.",
          "line_start": 84,
          "line_end": 92,
          "claim_line": 88,
          "quote": "고마워 사실 지금도 연습실에서 춤 연습하고 있는데 특정 부분이 잘 안돼서 좀 쉬고 있었거든",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_012",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 춤 연습은 자신이 도와줄 수 있는 것이 없을 것 같다고 말한다.",
          "line_start": 93,
          "line_end": 95,
          "claim_line": 94,
          "quote": "춤 연습은 내가 도와줄 수 있는 게 없을 것 같은데",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_013",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "프리카",
          "summary": "프리카가 잠시 연락하는 것만으로도 마음이 편해지고 차분해졌다며 다시 연습하러 가겠다고 인사한다.",
          "line_start": 96,
          "line_end": 107,
          "claim_line": 100,
          "quote": "아냐 이렇게 잠시 연락하는 것만으로도 뭔가 마음이 편해졌어 차분해졌으니까 다시 연습하러 가야겠어 또 연락할게",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_prika_001__eac_014",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 프리카에게 연습을 열심히 하라고 응원한다.",
          "line_start": 108,
          "line_end": 110,
          "claim_line": null,
          "quote": "ㅇㅇ연습 열심히 해!",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        }
