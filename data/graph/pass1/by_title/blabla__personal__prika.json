          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 자신은 임무나 일정을 마음대로 선택할 수 있는 상황이 아니라는 프리카의 말에 동의한다.",
          "line_start": 51,
          "line_end": 53,
          "claim_line": 52,
          "quote": "그렇지",
          "refers_to_past": false,
          "chronology_type": "present",
