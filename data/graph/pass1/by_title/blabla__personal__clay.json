        {
          "item_id": "blabla_clay_001__eac_003",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "클레이",
          "summary": "클레이가 앞으로 지휘관과 함께하게 된다고 해서 인사드리려고 블라를 보냈다고 밝히며, 어려운 동작은 아직 서툴지만 관중의 호응 유도와 시선을 사로잡는 것에는 자신이 있으니 지휘관을 열심히 응원해 주겠다고 말한다.",
          "line_start": 15,
          "line_end": 35,
          "claim_line": 16,
          "quote": "ㅎㅎ 앞으로 코치님이랑 함께 하게 된다고 해서\n인사 드리려고 블라 드렸어요옷~~\n저는 어려운 동작은 아직 좀 서툴지만\n관중들의 호응 유도랑 시선 사로잡는 건\n자신있어요옷!! ㅎㅎㅎ\n열심히 코치님을 응원해드릴게요옷!!\nㅎㅎㅎㅎ",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
