          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 본인만 갈 수 있다면 시사회에 안 가면 되지 않냐고 말한다.",
          "line_start": 36,
          "line_end": 38,
          "claim_line": 37,
          "quote": "그럼 안 가면 되잖아",
          "refers_to_past": false,
