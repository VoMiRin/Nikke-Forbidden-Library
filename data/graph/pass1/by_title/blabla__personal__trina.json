      "events_and_claims": [
        {
          "item_id": "blabla_trina_002__eac_001",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "트리나",
          "summary": "트리나가 날씨가 좋다며 지금 아이들과 함께 방주의 공원에 나와 있다고 지휘관에게 알린다.",
          "line_start": 3,
          "line_end": 14,
          "claim_line": 13,
          "quote": "햇님~\n오늘은 날씨가 참 좋네요~\n저는 지금 아이들이랑\n방주의 공원에 나와 있어요",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_002",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "트리나",
          "summary": "지휘관이 새들과 같이 간 것이냐고 묻자, 트리나는 맞다며 원래 겁이 많아 항상 자기 옆에 꼭 붙어 있는데 오늘은 기분이 좋은지 멀리까지 날아다니고 있다고 답한다.",
          "line_start": 15,
          "line_end": 32,
          "claim_line": 19,
          "quote": "새들이랑 같이 간 거야?\n네 맞아요~\n원래 겁이 많은 아이들이라\n항상 제 옆에 꼭 붙어있는데\n오늘은 기분이 좋은지\n멀리까지 날아다니고 있네요ㅎㅎ",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_003",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 오늘 날씨가 정말 좋긴 하다고 공감한다.",
          "line_start": 33,
          "line_end": 35,
          "claim_line": 34,
          "quote": "오늘 날씨가 진짜 좋긴 하더라",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_004",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "트리나",
          "summary": "트리나가 온도도 적당해 나들이 가기 딱 좋은 날씨라며, 새들도 지휘관을 보고 싶어 하는 것 같으니 공원으로 오라고 권유한다.",
          "line_start": 36,
          "line_end": 59,
          "claim_line": null,
          "quote": "후후\n그렇죠~?\n온도도 적당해서\n나들이 가기에 딱 좋은 날씨랍니다~\n음\n괜찮으시면\n햇님도 오시는 게 어떠세요?\n아이들도 보고 싶어 하는 것 같은데 ㅎㅎ",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_005",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 오후에 중요한 회의가 있어서 가지 못한다고 답한다.",
          "line_start": 60,
          "line_end": 62,
          "claim_line": 61,
          "quote": "오후에 중요한 회의가 있어서ㅜㅜ",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_006",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "트리나",
          "summary": "트리나가 지휘관이 오지 못한다는 말에 아쉬워한다.",
          "line_start": 63,
          "line_end": 71,
          "claim_line": 70,
          "quote": "으으음\n그렇군요\n아쉽네요ㅠㅠ",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_007",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관, 트리나",
          "summary": "지휘관이 다음에 같이 가자고 제안하고 트리나가 그러는 게 좋겠다며 동의한다.",
          "line_start": 72,
          "line_end": 80,
          "claim_line": null,
          "quote": "다음에 같이 가자\n네에\n그러는 게 좋겠어요",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_008",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "트리나",
          "summary": "트리나가 방주 안인데도 공원이 엄청 파릇파릇해서 마치 하나가 되고 싶은 느낌이라고 말한다.",
          "line_start": 81,
          "line_end": 98,
          "claim_line": 97,
          "quote": "후후\n그나저나\n여긴 방주 안인데도\n엄청 파릇파릇하네요\n마치\n하나가 되고 싶은 느낌이랄까요?",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_009",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관, 트리나",
          "summary": "지휘관이 하나가 된다는 말이 무슨 뜻인지 묻자 트리나는 웃으며 잠시만 기다려 달라고 한다.",
          "line_start": 99,
          "line_end": 110,
          "claim_line": null,
          "quote": "? 하나가 되다니\n후후\n후후후\n잠시만 기다려주세요",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_010",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 트리나를 부르지만 답장이 오지 않는다.",
          "line_start": 111,
          "line_end": 116,
          "claim_line": null,
          "quote": "트리나?\n트리나에게 답장이 오지 않는다.",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_011",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지문",
          "summary": "지휘관이 독백으로 설마 자신이 생각하는 그 일은 아닐 것이라고 추측한다.",
          "line_start": 117,
          "line_end": 119,
          "claim_line": 118,
          "quote": "설마 내가 생각하는 그건 아니겠지···.",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_012",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "트리나",
          "summary": "돌아온 트리나가 한결 낫다고 하자 지휘관이 무엇을 하고 왔는지 묻고, 트리나는 자연에 한 꺼풀 더 가까워지고 왔다며 이대로 한숨 자고 갈까 싶다고 답한다.",
          "line_start": 120,
          "line_end": 134,
          "claim_line": 130,
          "quote": "휴우\n한결 낫네요~\n뭐 하고 왔어?\n자연에 한 꺼풀 더 가까워지고 왔어요 ㅎㅎ\n이대로 한숨 자고 갈까 싶네요",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_013",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 트리나에게 잠은 숙소에서 자는 게 좋겠다고 권한다.",
          "line_start": 135,
          "line_end": 137,
          "claim_line": null,
          "quote": "잠은 숙소에서 자는 게",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_014",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "트리나",
          "summary": "트리나가 풀밭에 누워 있으니 벌써 조금 나른해졌다고 말한다.",
          "line_start": 138,
          "line_end": 146,
          "claim_line": 145,
          "quote": "으음\n풀밭에 누워있으니까\n벌써 조금 나른해졌어요",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_015",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 트리나에게 기다리고 있으면 곧 가겠다고 알린다.",
          "line_start": 147,
          "line_end": 149,
          "claim_line": null,
          "quote": "기다리고 있어 곧 갈게",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_trina_002__eac_016",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "트리나, 지휘관",
          "summary": "트리나가 오타 섞인 메시지로 아이들과 좀 쉬고 있을 테니 천천히 오라고 답하고 지휘관이 알겠다고 한다.",
          "line_start": 150,
          "line_end": 164,
          "claim_line": null,
          "quote": "ㅇㅓ머 정말요?\nㅎㄹㅎㅎ\n그럼 아이들이랑 좀 쉬고 있을 테ㄴㅣ\n처넟ㄴ히 와주ㅅㅔ요\n알겠어",
          "refers_to_past": false,
