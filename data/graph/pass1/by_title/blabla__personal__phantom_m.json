          "confidence": null,
          "actor_or_speaker": "팬텀",
          "summary": "팬텀이 물건을 훔치는 괴도를 말한 것이 맞다고 확인한다.",
          "line_start": 100,
          "line_end": 105,
          "claim_line": 104,
          "quote": "아~ 물건을 훔치는 괴도 말하는 거야?\n글었쏘",
          "refers_to_past": false,
          "chronology_type": "present",
