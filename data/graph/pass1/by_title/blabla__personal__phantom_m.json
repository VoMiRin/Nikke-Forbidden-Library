        },
        {
          "item_id": "blabla_phantom_m_001__eac_013",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 물건을 훔치는 괴도를 말하는 것이냐고 확인한다.",
          "line_start": 100,
          "line_end": 102,
          "claim_line": null,
          "quote": "아~ 물건을 훔치는 괴도 말하는 거야?",
          "refers_to_past": false,
