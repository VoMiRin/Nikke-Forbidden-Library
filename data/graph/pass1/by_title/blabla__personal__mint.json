          "line_start": 42,
          "line_end": 44,
          "claim_line": 43,
          "quote": "그렇네",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_mint_001__eac_006",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "민트",
          "summary": "민트가 연예계 쪽 사람 말고 자신의 개인 연락처를 아는 것은 지휘관이 최초이니 뿌듯해해도 된다고 말한다.",
