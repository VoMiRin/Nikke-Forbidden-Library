      "events_and_claims": [
        {
          "item_id": "blabla_colorless_03_001__eac_001",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "마르차나",
          "summary": "마르차나가 지휘관과 프리바티를 단체 채팅방에 초대한다.",
          "line_start": 3,
          "line_end": 8,
          "claim_line": null,
          "quote": "[MSG SENDER=\"시스템\" IS_SYSTEM=\"true\"]\n    마르차나님이 지휘관님을 초대하였습니다.\n  [MSG_END]\n  [MSG SENDER=\"시스템\" IS_SYSTEM=\"true\"]\n    마르차나님이 프리바티님을 초대하였습니다.\n  [MSG_END]",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_002",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "마르차나",
          "summary": "마르차나가 지휘관과 프리바티에게 이번에도 감사했다고 인사한다.",
          "line_start": 9,
          "line_end": 14,
          "claim_line": null,
          "quote": "[MSG SENDER=\"마르차나\"]\n    이번엔\n  [MSG_END]\n  [MSG SENDER=\"마르차나\"]\n    아니 이번에도 감사했습니다\n  [MSG_END]",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_003",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "프리바티",
          "summary": "프리바티가 마르차나에게 이제 괜찮은 건지 안부를 묻는다.",
          "line_start": 15,
          "line_end": 20,
          "claim_line": null,
          "quote": "[MSG SENDER=\"프리바티\"]\n    마르차나!\n  [MSG_END]\n  [MSG SENDER=\"프리바티\"]\n    이젠 괜찮으신 건가요?\n  [MSG_END]",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_004",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "마르차나",
          "summary": "마르차나가 자신은 자유롭게 돌아다녀도 좋다고 허가를 받았다며, 자신보다는 학생들이 걱정이라고 답한다.",
          "line_start": 21,
          "line_end": 32,
          "claim_line": 28,
          "quote": "[MSG SENDER=\"마르차나\"]\n    저 말씀이신가요?\n  [MSG_END]\n  [MSG SENDER=\"마르차나\"]\n    네\n  [MSG_END]\n  [MSG SENDER=\"마르차나\"]\n    자유롭게 돌아다녀도 좋다고 허가받았습니다\n  [MSG_END]\n  [MSG SENDER=\"마르차나\"]\n    저보다는 학생들이 걱정이군요\n  [MSG_END]",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_005",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 또 이런 일이 일어나면 안 될 텐데라며 학생들을 걱정한다.",
          "line_start": 33,
          "line_end": 35,
          "claim_line": 34,
          "quote": "또 이런 일이 일어나면 안 될 텐데",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_006",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "프리바티",
          "summary": "프리바티가 또 이런 일이 일어나면 안 된다는 지휘관의 말에 동의한다.",
          "line_start": 36,
          "line_end": 38,
          "claim_line": 37,
          "quote": "맞아요",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_007",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "마르차나",
          "summary": "마르차나가 그런 일이 다시 일어나는 것을 막기 위해 이 단체방을 만들었다고 말한다.",
          "line_start": 39,
          "line_end": 44,
          "claim_line": 43,
          "quote": "[MSG SENDER=\"마르차나\"]\n    그래서입니다\n  [MSG_END]\n  [MSG SENDER=\"마르차나\"]\n    이 단체방을 만든 건\n  [MSG_END]",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_008",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "마르차나",
          "summary": "프리바티가 되묻자, 마르차나는 통합 P반을 맡은 선생님들끼리 학생들을 지킬 수 있도록 서로 정보를 공유할 창구가 있어야 할 것 같아서 단체방을 만들었다고 설명한다.",
          "line_start": 45,
          "line_end": 56,
          "claim_line": 52,
          "quote": "[MSG SENDER=\"프리바티\"]\n    네?\n  [MSG_END]\n  [MSG SENDER=\"마르차나\"]\n    통합 P반을 맡은 선생님들끼리\n  [MSG_END]\n  [MSG SENDER=\"마르차나\"]\n    서로 정보를 공유할 수 있는 창구는 있어야 할 것 같아서요\n  [MSG_END]\n  [MSG SENDER=\"마르차나\"]\n    학생들을 지킬 수 있도록 말이죠\n  [MSG_END]",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_009",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "프리바티",
          "summary": "프리바티가 마르차나의 말에 공감하며, 미미르 부속고에서 일어나는 일들은 학생들에게 떠넘기는 게 아니라 선생님인 자신들이 책임지는 게 맞다며 지휘관에게 동의를 구한다.",
          "line_start": 57,
          "line_end": 71,
          "claim_line": 64,
          "quote": "[MSG SENDER=\"프리바티\"]\n    후우 그렇네요\n  [MSG_END]\n  [MSG SENDER=\"프리바티\"]\n    미미르 부속고에서 일어나는 일들은\n  [MSG_END]\n  [MSG SENDER=\"프리바티\"]\n    우리 선생님이 책임지는 게 맞으니까요\n  [MSG_END]\n  [MSG SENDER=\"프리바티\"]\n    학생들한테 떠넘기는 게 아니라요\n  [MSG_END]\n  [MSG SENDER=\"프리바티\"]\n    그쵸 지휘관?\n  [MSG_END]",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_010",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 프리바티가 자신의 말을 기억해 주고 있었다며 호응한다.",
          "line_start": 72,
          "line_end": 74,
          "claim_line": 73,
          "quote": "응 내 말 기억해주고 있었구나",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_011",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "프리바티",
          "summary": "프리바티가 당연하다며 지휘관의 말을 어떻게 잊겠냐고 답하고 앞으로도 잘 부탁한다고 인사한다.",
          "line_start": 75,
          "line_end": 86,
          "claim_line": 79,
          "quote": "[MSG SENDER=\"프리바티\"]\n    그, 그야 당연하죠\n  [MSG_END]\n  [MSG SENDER=\"프리바티\"]\n    어떻게 잊겠어요\n  [MSG_END]\n  [MSG SENDER=\"프리바티\"]\n    아무튼\n  [MSG_END]\n  [MSG SENDER=\"프리바티\"]\n    앞으로도 잘 부탁해요\n  [MSG_END]",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_colorless_03_001__eac_012",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "마르차나",
          "summary": "마르차나가 자신야말로 잘 부탁드린다고 인사한다.",
          "line_start": 87,
          "line_end": 89,
          "claim_line": null,
          "quote": "저야말로 잘 부탁드립니다",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        }
      ],
