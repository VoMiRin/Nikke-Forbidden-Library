        {
          "item_id": "blabla_mihara_001__eac_007",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "미하라",
          "summary": "미하라가 주문한 물품은 별것 아니고 안마기 같은 것이며, 그냥 자신의 몸에 가져다 대기만 하면 된다고 설명한다.",
          "line_start": 33,
          "line_end": 41,
