        {
          "item_id": "blabla_dirtybackyard_02_001__eac_003",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "의로운 협객",
          "summary": "의로운 협객(목단)이 슈가가 지휘관을 뺏어가듯 데려가 버렸고 따로 연락하면 또 뭐라고 할까 봐 슈가에게 들키고 싶지 않아서 이름을 바꿨다고 설명하며, 아까 일에 대해 다시 한번 사과한다.",
          "line_start": 18,
          "line_end": 38,
          "claim_line": 19,
          "quote": "슈가한테 들키고 싶지 않아서!!\n저 녀석이 완전 동생을 뺏어가듯 데려가 버렸잖아\n따로 연락하면 또 뭐라고 할까 봐\n그것 보다도\n어어\n다시 한번 사과하고 싶어서\n아깐 진짜 미안했어",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_dirtybackyard_02_001__eac_004",
