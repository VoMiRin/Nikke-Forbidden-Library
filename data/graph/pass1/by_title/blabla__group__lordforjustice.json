          "confidence": null,
          "actor_or_speaker": "목단",
          "summary": "아르카나의 채팅을 보고 지휘관 옆에서 달리고 있는 목단이 혀를 찬다.",
          "line_start": 105,
          "line_end": 107,
          "claim_line": null,
          "quote": "아르카나의 채팅을 보고, 옆에서 달리고 있는 목단이 혀를 찼다.",
          "refers_to_past": false,
