          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "레오나",
          "summary": "레오나가 아쉬워하며 티미가 언제 정이 들었는지 자꾸 지휘관을 찾는다고 말한다.",
          "line_start": 15,
          "line_end": 23,
