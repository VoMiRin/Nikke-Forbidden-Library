          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 방금 말이 바뀐 것 같다고 지적한다.",
          "line_start": 96,
          "line_end": 98,
          "claim_line": 97,
          "quote": "? 방금 말이 바뀐 것 같은데",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_leona_003__eac_014",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "레오나",
          "summary": "레오나가 말이 바뀐 것이 아니라고 부인한다.",
          "line_start": 96,
          "line_end": 101,
          "claim_line": 100,
          "quote": "? 방금 말이 바뀐 것 같은데\n아냐",
          "refers_to_past": false,
