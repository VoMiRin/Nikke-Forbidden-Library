          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 '형 얘기밖ㅇ'까지 메시지가 보내졌다고 짚는다.",
          "line_start": 102,
          "line_end": 104,
          "claim_line": 103,
          "quote": "형 얘기밖ㅇ 까지 보내졌는데",
