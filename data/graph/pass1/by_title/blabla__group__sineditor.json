          "confidence": null,
          "actor_or_speaker": "팬텀",
          "summary": "팬텀이 지휘관에게 레이블을 찾아간 일에 진전이 있었는지 묻는다.",
          "line_start": 27,
          "line_end": 32,
          "claim_line": null,
          "quote": "그레서\n진전은 이써쏘?",
