          "in_branch_option": null
        },
        {
          "item_id": "blabla_sineditor_001__eac_008",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 특별한 정보는 딱히 없었지만 레이블의 방 옆 창고에서 다과회를 했다고 전한다.",
          "line_start": 45,
          "line_end": 50,
          "claim_line": 49,
          "quote": "그런 건 딱히 없었는데\n옆 창고에서 다과회를 했어",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_sineditor_001__eac_009",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "팬텀, 아르카나",
          "summary": "팬텀이 다과회냐며 되묻고, 아르카나가 과자와 차를 대접하는 그 다과회가 맞는지 확인을 요청한다.",
          "line_start": 51,
          "line_end": 59,
          "claim_line": null,
          "quote": "다과회?\n제가 아는 그거 맞죠?\n과자랑 차를 대접하는 그거?",
          "refers_to_past": false,
