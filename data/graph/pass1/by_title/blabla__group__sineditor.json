        {
          "item_id": "blabla_sineditor_001__eac_003",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "팬텀",
          "summary": "팬텀이 지휘관이 레이블을 찾아간다는 이야기를 듣고 상황이 궁금해 대화방을 만들었다고 설명한다.",
