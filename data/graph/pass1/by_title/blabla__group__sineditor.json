        {
          "item_id": "blabla_sineditor_001__eac_013",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "아르카나",
          "summary": "아르카나가 지휘관의 말에 수긍하며 생각해 보니 자신과 팬텀도 레이블의 방에 들어가 본 적이 한 번도 없다고 말한다.",
