          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 과자와 차를 대접하는 다과회가 맞다고 확인해 준다.",
          "line_start": 60,
          "line_end": 62,
          "claim_line": 61,
          "quote": "응 맞아",
