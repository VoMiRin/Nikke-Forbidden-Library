        {
          "item_id": "blabla_sineditor_001__eac_011",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "팬텀",
          "summary": "팬텀이 레이블에게 다과회 같은 취미가 있었다니 의외라고 반응한다.",
          "line_start": 63,
          "line_end": 68,
          "claim_line": 64,
          "quote": "그녀애게 그런 취미가 있었다니\n의외로군",
