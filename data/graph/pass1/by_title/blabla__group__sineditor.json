        {
          "item_id": "blabla_sineditor_001__eac_012",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 기분 탓인지는 모르겠지만 레이블이 뭔가 자기 방에 못 들어가게 하는 것 같았다고 말한다.",
          "line_start": 69,
          "line_end": 74,
          "claim_line": 73,
          "quote": "그리고 기분 탓인지는 모르겠는데\n뭔가 자기 방에 못 들어가게 하는 거 같았어",
          "refers_to_past": true,
          "chronology_type": "present",
