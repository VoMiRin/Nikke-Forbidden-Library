          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "신데렐라",
          "summary": "신데렐라가 그레이브와 지휘관이 서로를 칭찬하는 모습이 정말 아름답다고 말한다.",
          "line_start": 54,
