        {
          "item_id": "blabla_oldtales_002__eac_001",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 굉장한 것을 받았다며, 그냥도 찰랑거렸던 신데렐라의 머릿결이 지금은 펄럭거린다고 감탄한다.",
          "line_start": 3,
          "line_end": 17,
          "claim_line": 7,
          "quote": "굉장하다\n굉장한 걸 받았다\n신데렐라의 머릿결\n그냥도 찰랑거렸다\n지금은 펄럭거린다",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_002__eac_002",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "신데렐라",
          "summary": "신데렐라가 머리카락에서 아름다운 향기도 나고 아름다움이 한층 깊어진 느낌이라고 말한다.",
          "line_start": 18,
          "line_end": 23,
          "claim_line": 19,
          "quote": "게다가 아름다운 향기도 나고 있어.\n아름다움이 한층 깊어진 느낌이야.",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_002__eac_003",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 다행이라며 아니스에게 빌린 것이라고 밝힌다.",
          "line_start": 24,
          "line_end": 26,
          "claim_line": 25,
          "quote": "다행이야ㅎㅎ 아니스한테 빌렸어",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_002__eac_004",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "신데렐라",
          "summary": "신데렐라가 헤어 에센스가 좋다며 그레이브가 잘 가르쳐 준 덕분에 지휘관의 머리 빗는 능력도 늘었다고 말한다.",
          "line_start": 27,
          "line_end": 38,
          "claim_line": 34,
          "quote": "헤어 에센스.\n좋네.\n왕자님의 머리 빗는 능력도 늘었고.\n그레이브가 잘 가르쳐준 덕분이겠지.",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_002__eac_005",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 자신의 덕분이 아니라며 지휘관이 똑똑해서 하나를 알려 주면 열을 알고 금방 배웠다고 칭찬한다.",
          "line_start": 39,
          "line_end": 50,
          "claim_line": 43,
          "quote": "그렇지 않다\n탈인간 똑똑하다\n하나를 알려주면 열을 안다\n금방 배웠다",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_002__eac_006",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 그레이브가 쉽게 알려 줘서 금방 배운 것이라고 답한다.",
          "line_start": 51,
          "line_end": 53,
          "claim_line": 52,
          "quote": "그레이브가 쉽게 알려줘서 그래",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
