        {
          "item_id": "blabla_oldtales_001__eac_001",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "신데렐라",
          "summary": "신데렐라가 지휘관과 그레이브를 부르며 큰 문제가 생겼다고 말한다.",
          "line_start": 3,
          "line_end": 8,
          "claim_line": 7,
          "quote": "왕자님, 그레이브.\n큰 문제가 생겼어.",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_002",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 신데렐라에게 무슨 일인지 묻는다.",
          "line_start": 9,
          "line_end": 14,
          "claim_line": null,
          "quote": "신데렐라\n무슨 일인가",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_003",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "신데렐라",
          "summary": "신데렐라가 머리카락 끝이 조금 엉켜버렸다고 말한다.",
          "line_start": 15,
          "line_end": 17,
          "claim_line": 16,
          "quote": "머리카락 끝이 조금 엉켜버렸어.",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_004",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 놀라며 자신이 머리카락을 엉키게 한 것인지 신데렐라에게 묻는다.",
          "line_start": 18,
          "line_end": 26,
          "claim_line": null,
          "quote": "이럴 수가\n내 탓인가 신데렐라\n내가 엉키게 했나",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_005",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "신데렐라",
          "summary": "신데렐라가 그레이브 탓이 아니라며, 어제 지휘관이 정성스레 머리를 빗겨줬지만 마무리가 조금 아름답지 못했던 것 같다고 답한다.",
          "line_start": 27,
          "line_end": 35,
          "claim_line": 31,
          "quote": "아냐.\n어제 왕자님이 정성스레 빗겨줬어.\n하지만 마무리가 조금 아름답지 못했나 봐.",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_006",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 지휘관에게 신데렐라의 길고 찰랑거리는 머리카락은 매우 섬세하므로 끝부분까지 모두 신경 써서 빗어야 한다고 지적한다.",
          "line_start": 36,
          "line_end": 53,
          "claim_line": 40,
          "quote": "탈인간\n신데렐라의 머리카락은 매우 섬세하다\n그래서 적당히 정성을 들이는 것으로는 안 된다\n길고 찰랑거리는 머리카락이기 때문에\n끝부분의 끝부분까지\n모두 신경 써서 빗어야만 한다",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_007",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 미안하다고 사과한다.",
          "line_start": 54,
          "line_end": 56,
          "claim_line": null,
          "quote": "미안해···",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_008",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 미안하다는 말로는 안 된다며, 엉킨 머리카락을 머릿결이 상하지 않게 푸는 데는 큰 고통과 빗을 때보다 더 큰 정성과 능력이 필요하다고 다그친다.",
          "line_start": 57,
          "line_end": 71,
          "claim_line": 70,
          "quote": "미안하다는 말로는 안 된다\n머리카락이 엉키면\n푸는데 얼마나 큰 고통이 따르는지 알고 있나\n게다가 머릿결이 상하지 않도록 풀어야 하기 때문에\n빗을 때보다 더 큰 정성과 능력이 필요하다",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_009",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 거듭 미안하다고 사과한다.",
          "line_start": 72,
          "line_end": 74,
          "claim_line": null,
          "quote": "미안···",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_010",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "신데렐라",
          "summary": "신데렐라가 그레이브를 말리며 이 정도로 화를 내는 것은 아름답지 않고 자신은 괜찮다고 말한다.",
          "line_start": 75,
          "line_end": 83,
          "claim_line": 79,
          "quote": "그레이브, 그만.\n이 정도로 화를 내는 건 아름답지 않아.\n나는 괜찮아.",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_011",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 알겠다며 자신이 조금 흥분했다고 인정한다.",
          "line_start": 84,
          "line_end": 89,
          "claim_line": 88,
          "quote": "알겠다\n조금 흥분했다",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_012",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 역시 신데렐라라며 감탄한다.",
          "line_start": 90,
          "line_end": 92,
          "claim_line": 91,
          "quote": "역시 신데렐라",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_013",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "신데렐라",
          "summary": "신데렐라가 앞으로 머리가 엉키는 일이 또 생겨서는 안 된다며 그레이브에게 지휘관에게 직접 머리 빗는 법을 알려 달라고 요청한다.",
          "line_start": 93,
          "line_end": 101,
          "claim_line": null,
          "quote": "음.\n앞으로 이런 일이 또 생겨서는 안 되니까,\n그레이브가 직접 머리 빗는 법을 알려주겠어?",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_014",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "신데렐라",
          "summary": "신데렐라가 그레이브는 머리를 빗기는 속도, 압력, 느낌 등 모든 것이 완벽하다고 칭찬한다.",
          "line_start": 105,
          "line_end": 110,
          "claim_line": 109,
          "quote": "머리를 빗기는 속도, 압력, 느낌.\n그레이브는 모든 게 완벽하거든.",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_015",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 신데렐라의 요청을 수락하고 지휘관에게 어디에 있는지 물으며 빗질 강의를 해 주겠다고 말한다.",
          "line_start": 111,
          "line_end": 119,
          "claim_line": null,
          "quote": "알겠다\n탈인간 어디에 있나\n빗질 강의를 해주겠다",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_016",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 빗질 강의까지 하는 것이냐고 묻는다.",
          "line_start": 120,
          "line_end": 122,
          "claim_line": null,
          "quote": "강의까지 하는 거야?",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_017",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 지휘관의 태도가 좋지 않다며 신데렐라의 머리를 빗기는 것은 강의가 필요할 정도로 중요한 일이라고 주장한다.",
          "line_start": 123,
          "line_end": 131,
          "claim_line": 130,
          "quote": "강의까지?\n그런 태도는 좋지 않다\n강의가 필요할 정도로 중요한 일이다",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_018",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 그레이브에게 사과한다.",
          "line_start": 132,
          "line_end": 134,
          "claim_line": null,
          "quote": "미안···",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_019",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "그레이브",
          "summary": "그레이브가 빗을 종류별로 챙겨 놓을 테니 시간이 되는 대로 오라고 지시한다.",
          "line_start": 135,
          "line_end": 140,
          "claim_line": null,
          "quote": "빗을 종류별로 챙겨놓겠다\n시간이 되는대로 와라",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_oldtales_001__eac_020",
