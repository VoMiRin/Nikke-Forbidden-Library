          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "아비스타",
          "summary": "아비스타가 아니스가 처음 음악 방송 무대에 나왔을 때 누가 봐도 긴장한 모습이었는데 그 모습이 무척 귀여웠다고 회상한다.",
          "line_start": 99,
          "line_end": 110,
          "claim_line": 103,
          "quote": "처음 음악 방송 무대에 나왔을 때는 말이죠\n누가 봐도 긴장한 모습이었거든요?\n그때 그 모습이 얼마나 귀여웠는지\n못 본 사람은 모를 거예요!",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
