          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 아비스타에게 아니스한테 직접 연락해 보라고 권하며 연락하면 아니스도 좋아할 것이라고 말한다.",
          "line_start": 33,
          "line_end": 38,
