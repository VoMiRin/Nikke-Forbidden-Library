          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 아비스타에게 안경을 벗은 모습을 한번 보여줄 수 있는지 묻는다.",
          "line_start": 81,
