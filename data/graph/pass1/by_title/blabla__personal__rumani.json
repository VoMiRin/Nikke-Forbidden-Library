          "in_branch_option": null
        },
        {
          "item_id": "blabla_rumani_001__eac_005",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "루마니",
          "summary": "루마니가 이전에는 단순 트레이너와 회원으로서 간단한 조언만 했으나 이제 정식으로 팀을 이루게 되었으니 제대로 붙어서 PT를 해 주겠다고 말한다.",
          "line_start": 33,
          "line_end": 47,
          "claim_line": 43,
          "quote": "아뇨 그전에는 정말 단순 트레이너와 회원으로서 간단한 조언밖에 해드리지 못했지만 이제 정식으로 팀을 이룰 수 있게 되었으니 제대로 붙어서 PT를 해드릴게요",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_rumani_001__eac_006",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "루마니",
          "summary": "지휘관이 그렇게까지 하냐고 묻자, 루마니가 당연히 자신이 해야 할 일이라고 답한다.",
          "line_start": 48,
          "line_end": 53,
          "claim_line": 52,
          "quote": "그렇게까지? 당연히 제가 해야 할 일인걸요",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_rumani_001__eac_007",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "루마니가 최근 앉아서 하는 업무가 많았는지 묻자, 지휘관이 조금 있었다고 답한다.",
          "line_start": 54,
          "line_end": 62,
          "claim_line": 61,
          "quote": "회원님 최근 앉아서 하는 업무가 많으셨죠? 좀 있긴 했지",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_rumani_001__eac_008",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "루마니",
          "summary": "루마니가 지켜보니 지휘관에게 거북목이 살짝 생기고 어깨도 조금 말렸다며 자세 교정부터 진행하면 좋겠다고 말한다.",
          "line_start": 63,
          "line_end": 71,
          "claim_line": 64,
          "quote": "지켜봤었는데 거북목이 살짝 생기셨어요 어깨도 조금 말리셨고요 자세 교정부터 진행하면 좋을 것 같아요",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_rumani_001__eac_009",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "루마니",
          "summary": "루마니가 지휘관이 운동 전에 스트레칭을 하지 않더라며, 근육 부상과 자세 무너짐을 막기 위해 운동 전후로 할 수 있는 20분짜리 스트레칭을 알려 주겠다고 말한다.",
          "line_start": 75,
          "line_end": 92,
          "claim_line": 76,
          "quote": "그리고 운동 전에 스트레칭을 하지 않으시던데 무게를 치고 땀을 내는 것도 중요하지만 운동 전에 스트레칭을 하는 건 필수예요 자칫하다가 근육이 다치거나 자세가 무너질 수도 있으니까요 그러니 운동 전후로 할 수 있는 20분짜리 스트레칭도 알려드릴게요",
          "refers_to_past": true,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_rumani_001__eac_010",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 루마니의 말을 잠시 제지하려 한다.",
          "line_start": 93,
          "line_end": 95,
          "claim_line": null,
          "quote": "아니 잠깐",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_rumani_001__eac_011",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "루마니",
          "summary": "루마니가 지휘관이 계획 없이 그때마다 하고 싶은 운동만 하더라며, 앞으로는 약한 근육 부위와 지방층을 분석해 최고의 운동 플랜을 짜 주겠다고 말한다.",
          "line_start": 96,
          "line_end": 116,
          "claim_line": 97,
          "quote": "운동을 하실 때에도 크게 계획을 잡지 않고 그때마다 하고 싶은 걸 하시던데 앞으로는 제가 플랜을 짜드릴게요 어떤 부위의 근육이 약한지 어디에 지방층이 많은지를 분석한 다음 회원님에게 맞는 최고의 플랜을 짜드릴 테니 기대하셔도 좋아요",
          "refers_to_past": true,
