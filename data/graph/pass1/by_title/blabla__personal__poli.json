          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 무슨 소리냐며 전초기지가 평화로운 것은 폴리 덕분이라고 말한다.",
          "line_start": 45,
          "line_end": 53,
          "claim_line": 52,
          "quote": "  [MSG SENDER=\"지휘관\" IS_SENDER=\"true\"]\n    그게 무슨 소리야?\n  [MSG_END]\n  [MSG SENDER=\"폴리\"]\n    넹?\n  [MSG_END]\n  [MSG SENDER=\"지휘관\" IS_SENDER=\"true\"]\n    폴리 덕분에 평화로운 거야\n  [MSG_END]",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
