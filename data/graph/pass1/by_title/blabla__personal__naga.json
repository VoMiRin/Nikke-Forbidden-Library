        },
        {
          "item_id": "blabla_naga_001__eac_004",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "나가",
          "summary": "나가가 자신이 워낙 티아를 잘 챙겨서 어머니 같다는 말을 종종 듣기는 하지만, 친구인데 어머니라고 하는 건 너무하다고 답한다.",
          "line_start": 30,
          "line_end": 47,
          "claim_line": 40,
          "quote": "???\nㅋㅋㅋㅋㅋㅋㅋ\n그런 얘기를 종종 듣기는 해\n내가 워낙 티아를 잘 챙기거든\n그래도 친구인데 어머니라니\n너무하네~",
          "refers_to_past": false,
