      "events_and_claims": [
        {
          "item_id": "blabla_naga_001__eac_001",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "나가",
          "summary": "나가가 지휘관에게 인사하며 자신이 미미르 부속 고등학교에서 티아와 같은 졸업반 학생이고 다즐링 펄 스쿼드 소속이라고 자기소개를 한다.",
          "line_start": 3,
          "line_end": 20,
          "claim_line": 13,
          "quote": "반가워 선생님\n아\n소개부터 해야 됐는데 미안해~\n미미르 부속 고등학교 학생이야\n티아랑 같은 졸업반\n[다즐링 펄] 스쿼드 소속이구~",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_naga_001__eac_002",
          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "나가",
          "summary": "나가가 티아가 평소에도 폐를 많이 끼친다며 지휘관이 늘 고생이 많다고 말한다.",
          "line_start": 21,
          "line_end": 26,
          "claim_line": 25,
          "quote": "우리 티아가 평소에도 폐 많이 끼치지?\n선생님이 늘 고생이 많아",
          "refers_to_past": false,
          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_naga_001__eac_003",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "지휘관",
          "summary": "지휘관이 나가에게 혹시 티아의 어머니냐고 농담조로 묻는다.",
          "line_start": 29,
          "line_end": 29,
          "claim_line": null,
          "quote": "혹시 티아의 어머니?",
