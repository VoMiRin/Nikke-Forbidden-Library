          "confidence": null,
          "actor_or_speaker": "누아르",
          "summary": "누아르가 마지막 게임에서 루주가 예리하고 멋있었다고 칭찬한다.",
          "line_start": 84,
          "line_end": 89,
          "claim_line": 88,
