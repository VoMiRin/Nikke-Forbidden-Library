          "chronology_type": "present",
          "in_branch_option": null
        },
        {
          "item_id": "blabla_rapunzel_001__eac_007",
          "epistemic_type": "established_event",
          "confidence": null,
          "actor_or_speaker": "라푼젤",
          "summary": "라푼젤이 지휘관의 호출을 무시할 수는 없다며, 지상에서 자신이 필요하면 옆을 지킬 테니 언제든 연락하라고 약속한다.",
          "line_start": 48,
          "line_end": 59,
          "claim_line": null,
