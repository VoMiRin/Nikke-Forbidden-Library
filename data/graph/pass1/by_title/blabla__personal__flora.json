          "epistemic_type": "character_claim",
          "confidence": null,
          "actor_or_speaker": "플로라",
          "summary": "지휘관이 플로라를 닮은 꽃을 말해줘도 되냐고 묻자 플로라가 단 한 번도 자신을 닮은 꽃에 대해 들어본 적이 없다며 궁금해한다.",
          "line_start": 102,
