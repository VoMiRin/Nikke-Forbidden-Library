# Copy this file to .env.local and fill in your Gemini API key.
# .env.local is ignored by git.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_FILE_SEARCH_STORE=fileSearchStores/YOUR_STORE_NAME
GEMINI_MODEL=gemini-3-flash-preview
SYNC_GEMINI_FILE_SEARCH=1

# If you have multiple keys, use either format below and select with --key-index.
# Do not use multiple free keys to bypass provider rate limits or quota rules.

# GEMINI_API_KEYS=YOUR_KEY_1,YOUR_KEY_2,YOUR_KEY_3,YOUR_KEY_4

# GEMINI_API_KEY_1=YOUR_KEY_1
# GEMINI_API_KEY_2=YOUR_KEY_2
# GEMINI_API_KEY_3=YOUR_KEY_3
# GEMINI_API_KEY_4=YOUR_KEY_4

# Backend deploy settings. By default npm run deploy syncs File Search after
# the frontend build. Set SYNC_GEMINI_FILE_SEARCH=0 only for an emergency skip.
# SYNC_GEMINI_SECRET separately controls whether the first API key above is
# copied to Google Secret Manager for Cloud Run.
GEMINI_SECRET_NAME=nikke-gemini-api-key
SYNC_GEMINI_SECRET=1
RUN_MAX_INSTANCES=1
ASK_RATE_LIMIT_WINDOW_MS=600000
ASK_RATE_LIMIT_MAX_REQUESTS=5
ASK_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
ASK_GLOBAL_RATE_LIMIT_MAX_REQUESTS=6
ASK_DAILY_LIMIT_WINDOW_MS=86400000
ASK_DAILY_LIMIT_MAX_REQUESTS=70
GEMINI_RETRY_COUNT=3
GEMINI_RETRY_INITIAL_DELAY_MS=5000
GEMINI_RETRY_MAX_DELAY_MS=60000
GEMINI_PROVIDER_COOLDOWN_MS=60000
GEMINI_COUNT_TOKENS_BEFORE_REQUEST=0

# AI question/answer logs for later wiki review.
# In Cloud Run, npm run deploy sets ASK_LOG_PROJECT_ID to PROJECT_ID when this is empty.
ASK_LOG_STORAGE=firestore
ASK_LOG_PROJECT_ID=
ASK_LOG_DATABASE_ID=(default)
ASK_LOG_COLLECTION=aiAskLogs
ASK_LOG_DEFAULT_STATUS=pending_review
ASK_LOG_INCLUDE_PROMPT=1
ASK_LOG_INCLUDE_ANSWER=1
ASK_LOG_WRITE_TIMEOUT_MS=3000
SYNC_FIRESTORE_IAM=1
