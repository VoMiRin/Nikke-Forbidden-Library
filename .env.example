# Copy this file to .env.local and fill in your Gemini API key.
# .env.local is ignored by git.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_FILE_SEARCH_STORE=fileSearchStores/YOUR_STORE_NAME
GEMINI_MODEL=gemini-3-flash-preview

# If you have multiple keys, use either format below and select with --key-index.
# Do not use multiple free keys to bypass provider rate limits or quota rules.

# GEMINI_API_KEYS=YOUR_KEY_1,YOUR_KEY_2,YOUR_KEY_3,YOUR_KEY_4

# GEMINI_API_KEY_1=YOUR_KEY_1
# GEMINI_API_KEY_2=YOUR_KEY_2
# GEMINI_API_KEY_3=YOUR_KEY_3
# GEMINI_API_KEY_4=YOUR_KEY_4

# Backend deploy settings. npm run deploy reads .env.local and syncs the first
# Gemini API key above to Google Secret Manager for Cloud Run.
GEMINI_SECRET_NAME=nikke-gemini-api-key
SYNC_GEMINI_SECRET=1
ASK_RATE_LIMIT_WINDOW_MS=60000
ASK_RATE_LIMIT_MAX_REQUESTS=12
